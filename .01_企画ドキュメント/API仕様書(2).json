            "query": {},
            "body": null
          },
          "output": {
            "success": { "status": 200, "schema": "Reservation" },
            "error": { "schema": "ApiError" }
          }
        },
        {
          "operationId": "getReservationsByUser",
          "method": "GET",
          "summary": "ユーザーの予約一覧",
          "function": "getReservationsByUser",
          "input": {
            "path": {},
            "query": {
