{
  "title": "MESHITIME API仕様書",
  "version": "1.1.0",
  "updatedAt": "2026-07-31",
  "description": "Expo フロントエンドが利用する API 契約。主に Supabase（PostgreSQL）直結。menu のみ Express レガシー。",
  "base": {
    "supabaseUrl": "https://yarcsujzlvzbolgkolpd.supabase.co",
    "clientFile": "src/lib/supabase.ts",
    "expressBaseUrlEnv": "EXPO_PUBLIC_API_URL",
    "expressBaseUrlDefault": "http://localhost:3000",
    "contentType": "application/json"
  },
  "conventions": {
    "idType": "uuid string",
    "datetime": "ISO-8601 string",
    "dbNaming": "snake_case",
    "appNamingPinReservation": "camelCase",
    "errors": "throw PostgrestError or Error; HTTP wrapper なし（直接クライアント）",
    "successDelete": "null"
  },
  "schemas": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "address": { "type": "string" },
        "image_path": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "password", "address", "image_path", "created_at"]
    },
    "CreateUserPayload": {
      "type": "object",
      "properties": {
        "username": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "password": { "type": "string", "required": true },
        "address": { "type": "string", "required": false, "default": "" },
        "image_path": { "type": "string", "required": false, "default": "" },
        "id": { "type": "string", "format": "uuid", "required": false, "description": "Auth UUID と揃える場合" }
      }
    },
    "UpdateUserPayload": {
      "type": "object",
      "description": "Partial。更新したいフィールドのみ。",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "address": { "type": "string" },
        "image_path": { "type": "string" }
      }
    },
    "Store": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sname": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "address": { "type": "string" },
        "tel": { "type": "string" },
        "open_time": { "type": "string" },
        "star": { "type": "number" },
        "site": { "type": "string" },
        "image_path": { "type": "string" },
        "genre_id": { "type": ["string", "null"], "format": "uuid" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sname", "email", "password", "address", "created_at"]
    },
    "CreateStorePayload": {
      "type": "object",
      "properties": {
        "sname": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "password": { "type": "string", "required": true },
        "address": { "type": "string", "required": true },
        "tel": { "type": "string", "required": false, "default": "" },
        "open_time": { "type": "string", "required": false, "default": "" },
        "site": { "type": "string", "required": false, "default": "" },
        "image_path": { "type": "string", "required": false, "default": "" },
        "genre_id": { "type": ["string", "null"], "required": false },
        "latitude": { "type": ["number", "null"], "required": false },
        "longitude": { "type": ["number", "null"], "required": false },
        "star": { "type": ["number", "null"], "required": false, "default": 0 },
        "id": { "type": "string", "format": "uuid", "required": false }
      }
    },
    "UpdateStorePayload": {
      "type": "object",
      "description": "Partial。更新したいフィールドのみ。",
      "properties": {
        "sname": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "address": { "type": "string" },
        "tel": { "type": "string" },
        "open_time": { "type": "string" },
        "site": { "type": "string" },
        "image_path": { "type": "string" },
        "genre_id": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "star": { "type": "number" }
      }
    },
    "StorePin": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "storeId": { "type": "string", "format": "uuid" },
        "time": { "type": ["string", "null"] },
        "emptySeat": { "type": "number" },
        "rule": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "startsAt": { "type": ["string", "null"], "format": "date-time" },
        "endsAt": { "type": ["string", "null"], "format": "date-time" },
        "isActive": { "type": "boolean" },
        "store": { "$ref": "#/schemas/StorePinStore" },
        "coordinates": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        }
      }
    },
    "StorePinStore": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "tel": { "type": ["string", "null"] },
        "openTime": { "type": ["string", "null"] },
        "star": { "type": ["number", "null"] },
        "site": { "type": ["string", "null"] },
        "imagePath": { "type": ["string", "null"] },
        "genreId": { "type": ["string", "null"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string" }
      }
    },
    "CreateStorePinPayload": {
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "required": true },
        "emptySeat": { "type": "number", "required": true },
        "time": { "type": ["string", "null"], "required": false },
        "rule": { "type": ["string", "null"], "required": false },
        "description": { "type": ["string", "null"], "required": false },
        "startsAt": { "type": ["string", "null"], "required": false },
        "endsAt": { "type": ["string", "null"], "required": false },
        "isActive": { "type": "boolean", "required": false, "default": true }
      }
    },
    "UpdateStorePinPayload": {
      "type": "object",
      "description": "CreateStorePinPayload の Partial"
    },
    "Reservation": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "pinId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "failed", "cancelled"]
        },
        "partySize": { "type": "number" },
        "reservedAt": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "pin": { "type": ["object", "null"] }
      }
    },
    "CreateReservationPayload": {
      "type": "object",
      "properties": {
        "userId": { "type": "string", "required": true },
        "pinId": { "type": "string", "required": true },
        "partySize": { "type": "number", "required": false, "default": 1 },
        "reservedAt": { "type": ["string", "null"], "required": false },
        "note": { "type": ["string", "null"], "required": false }
      }
    },
    "UpdateReservationPayload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "failed", "cancelled"]
        },
        "partySize": { "type": "number" },
        "reservedAt": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "Genre": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gname": { "type": "string" },
        "image_path": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "Review": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "store_id": { "type": "string" },
        "user_id": { "type": "string" },
        "star": { "type": "number" },
        "comment": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "Favorite": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "store_id": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "FavWithStore": {
      "allOf": [
        { "$ref": "#/schemas/Favorite" },
        {
          "type": "object",
          "properties": {
            "store": { "$ref": "#/schemas/Store" }
          }
        }
      ]
    },
    "History": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "store_id": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "HistoryWithStore": {
      "allOf": [
        { "$ref": "#/schemas/History" },
        {
          "type": "object",
          "properties": {
            "store": { "$ref": "#/schemas/Store" }
          }
        }
      ]
    },
    "Menu": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mname": { "type": "string" },
        "store_id": { "type": "string" },
        "allergen": { "type": "string" },
        "ingredients": { "type": "string" },
        "description": { "type": "string" },
        "image_path": { "type": "string" },
        "created_at": { "type": "string" },
        "discount_id": { "type": ["string", "null"] },
        "catch_id": { "type": ["string", "null"] }
      }
    },
    "CreateMenu": {
      "type": "object",
      "properties": {
        "mname": { "type": "string", "required": true },
        "store_id": { "type": "string", "required": true },
        "allergen": { "type": "string", "required": true },
        "ingredients": { "type": "string", "required": true },
        "description": { "type": "string", "required": true },
        "image_path": { "type": "string", "required": true },
        "discount_id": { "type": ["string", "null"], "required": true },
        "catch_id": { "type": ["string", "null"], "required": true }
      }
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "code": { "type": "string", "description": "PostgREST / Postgres code" },
        "details": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] }
      }
    }
  },
  "resources": [
    {
      "name": "User",
      "table": "users",
      "clientFile": "src/api/userApi.ts",
      "transport": "supabase",
      "endpoints": [
        {
          "operationId": "getUser",
          "method": "GET",
          "summary": "ユーザー1件取得",
          "function": "getUser",
          "input": {
            "path": {
              "user_id": {
                "type": "string",
                "format": "uuid",
                "required": true,
                "description": "users.id"
              }
            },
            "query": {},
            "body": null
          },
          "output": {
            "success": {
              "status": 200,
              "schema": "User",
              "example": {
                "id": "11111111-1111-1111-1111-111111111111",
                "username": "taro",
                "email": "taro@example.com",
                "password": "***",
                "address": "Osaka",
                "image_path": "",
                "created_at": "2026-07-01T00:00:00.000Z"
              }
            },
            "error": { "schema": "ApiError" }
          }
        },
        {
          "operationId": "createUser",
          "method": "POST",
          "summary": "ユーザー作成",
          "function": "createUser",
          "input": {
            "path": {},
            "query": {},
            "body": {
              "schema": "CreateUserPayload",
              "required": true,
              "example": {
                "username": "taro",
                "email": "taro@example.com",
                "password": "secret",
                "address": "Osaka",
                "image_path": ""
              }
            }
          },
          "output": {
            "success": {
              "status": 201,
              "schema": "User",
              "description": "作成されたユーザー（id / created_at 付き）"
            },
            "error": { "schema": "ApiError" }
          }
        },
        {
          "operationId": "updateUser",
          "method": "PATCH",
          "summary": "ユーザー更新",
          "function": "updateUser",
          "input": {
            "path": {
              "user_id": {
                "type": "string",
                "format": "uuid",
                "required": true
              }
            },
            "query": {},
            "body": {
              "schema": "UpdateUserPayload",
              "required": true,
              "example": {
                "username": "taro_updated",
                "address": "Tokyo"
              }
            }
          },
          "output": {
            "success": {
              "status": 200,
              "schema": "User",
              "description": "更新後のユーザー"
            },
            "error": {
              "schema": "ApiError",
              "notes": ["body が空の場合 Error: No fields to update"]
            }
          }
        },
        {
          "operationId": "deleteUser",
          "method": "DELETE",
          "summary": "ユーザー削除",
          "function": "deleteUser",
          "input": {
            "path": {
              "user_id": {
                "type": "string",
                "format": "uuid",
                "required": true
              }
            },
            "query": {},
            "body": null
          },
          "output": {
            "success": {
              "status": 204,
              "schema": null,
              "value": null,
              "description": "削除成功時 null を返す"
            },
            "error": { "schema": "ApiError" }
          }
        }
      ]
    },
